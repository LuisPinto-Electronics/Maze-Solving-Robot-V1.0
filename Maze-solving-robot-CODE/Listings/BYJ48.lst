 233          /*
 234           * Calculates the motor delay according to
 235           * the current position in the movement.
 236           *
 237           * A simple five-stage acceleration profile is
 238           * applied during the first 10% of the movement.
 239           *
 240           * Parameters:
C51 COMPILER V9.60.7.0   BYJ48                                                             09/12/2026 17:05:56 PAGE 5   

 241           *      total_steps : Total movement steps.
 242           *      i_steps     : Current step.
 243           *
 244           * Returns:
 245           *      Delay in microseconds.
 246           */
 247          
 248          unsigned int delay_acel(unsigned int total_steps, unsigned int i_steps)
 249          {
 250   1          unsigned int accel_steps = total_steps / 10;   /// Solo acelerar el 10% de los pasos
 251   1      
 252   1          if(accel_steps < 5)
 253   1              accel_steps = 5; 
 254   1      
 255   1          if(i_steps < (accel_steps * 1) / 5)
 256   1              return aceleracion[0];
 257   1      
 258   1          else if(i_steps < (accel_steps * 2) / 5)
 259   1              return aceleracion[1];
 260   1      
 261   1          else if(i_steps < (accel_steps * 3) / 5)
 262   1              return aceleracion[2];
 263   1      
 264   1          else if(i_steps < (accel_steps * 4) / 5)
 265   1              return aceleracion[3];
 266   1      
 267   1          else
 268   1              return aceleracion[4];
 269   1      }


