  12   1             Para 4800 baudios a 12MHz:
  13   1                 65536 - 12000000/(32*4800) = 65536 - 78.125 =~ 65458 = 0xFFB2
  14   1                 (baud real resultante ~4807.7, error ~0.16%, aceptable)
  15   1          */
  16   1          T2CON = 0x34;   // TF2 EXF2 RCLK TCLK EXEN2 TR2 C/T2 CP/RL2 = 00110100
  17   1      
  18   1          RCAP2H = 0xFF;
  19   1          RCAP2L = 0xB2;
  20   1          TH2 = 0xFF;     // carga inicial igual al valor de recarga
  21   1          TL2 = 0xB2;
  22   1      
  23   1          SCON = 0x50;    // Modo 1 (8 bits), REN=1 (habilita recepcion)
  24   1      
  25   1          /// No actives ES si vas a esperar TI por polling en send_char.
  26   1      }
