   4          void uart_init(void)
   5          {
   6   1          /*
   7   1             Timer2 como generador de baud rate (RCLK=1, TCLK=1).
   8   1      
   9   1             Formula (Modo baud rate generator, clock fijo = Fosc/2
  10   1                 baud = Fosc / (32 * (65536 - [RCAP2H,RCAP2L]))
