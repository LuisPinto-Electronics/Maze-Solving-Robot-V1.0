  27          /*
  28           * Initializes Timer 0 for software PWM generation.
  29           *
  30           * Timer 0 operates in Mode 2 (8-bit auto-reload)
  31           * and generates the interrupts required to produce
  32           * the servo control pulses.
  33           */
  34          void servo_init(void)
  35          {
  36   1          TMOD &= 0xF0;
  37   1          TMOD |= 0x02;   // Timer0, Modo 2 (8 bits, auto-reload)
  38   1      
  39   1          TH0 = 0x9C;     // 256 - 100 = 156 = 0x9C  (recarga automática)
  40   1          TL0 = 0x9C;     // carga inicial igual
  41   1      
  42   1          IE |= 0x82;
  43   1          TR0 = 1;
  44   1      }
