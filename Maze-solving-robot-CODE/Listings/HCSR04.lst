   1          /*
   2           * HCSR04.c
   3           *
   4           * Author: Luis J. Pinto G.
   5           *
   6           * Description:
   7           * Driver for the HC-SR04 ultrasonic distance sensor.
   8           *
   9           * Timer 1 is configured in Gate mode, allowing the
  10           * microcontroller to measure the width of the ECHO pulse.
  11           *
  12           * The measured pulse width is converted into distance
  13           * expressed in centimeters.
  14           */
  15          
  16          #include "HCSR04.h"
  17          #include "delay.h"
  18          
  19          sbit TRIG_PIN = P3^4;
  20          sbit ECHO_PIN = P3^3;
  21          
  22          void sensor_HCSR04_init(void)
  23          {
  24   1          // Timer1: GATE=1, C/T=0, Modo 1 (16 bits) -> 1001 = 0x9
  25   1          TMOD &= ~0xF0;
  26   1          TMOD |= 0x90;
  27   1          TH1 = 0;
  28   1          TL1 = 0;
  29   1          TR1 = 1;
  30   1      }
  31          
  32          unsigned int get_distance_cm(void)
  33          {
  34   1          unsigned int tiempo_us;
  35   1          TH1 = 0;
  36   1          TL1 = 0;
  37   1          TRIG_PIN = 1;
  38   1          delay_us(10);
  39   1          TRIG_PIN = 0;
  40   1          while (ECHO_PIN == 0); /// esperita a que se ponga en 1
  41   1          while (ECHO_PIN == 1); /// bloquear programa hasta que se ponga en 0 el echo y leer el resultado
  42   1          tiempo_us = (TH1 << 8) | TL1; /// combinar 2 bytes para tener el resultado
  43   1          return tiempo_us / 58;
  44   1      }


